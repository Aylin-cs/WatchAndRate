<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.watchandrate.user_interface.LoginFragment"
        android:label="LoginFragment">

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_loginFragment_to_reviewFragment"
            app:destination="@id/reviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.watchandrate.user_interface.RegisterFragment"
        android:label="RegisterFragment">

        <action
            android:id="@+id/action_registerFragment_to_reviewFragment"
            app:destination="@id/reviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/reviewFragment"
        android:name="com.example.watchandrate.user_interface.ReviewFragment"
        android:label="ReviewFragment">

        <action
            android:id="@+id/action_reviewFragment_to_addReviewFragment"
            app:destination="@id/addReviewFragment" />

        <action
            android:id="@+id/action_reviewFragment_to_editReviewFragment"
            app:destination="@id/editReviewFragment" />

        <action
            android:id="@+id/action_reviewFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_reviewFragment_to_commentsFragment"
            app:destination="@id/commentsFragment" />
    </fragment>

    <fragment
        android:id="@+id/addReviewFragment"
        android:name="com.example.watchandrate.user_interface.AddReviewFragment"
        android:label="Add Review" />

    <fragment
        android:id="@+id/editReviewFragment"
        android:name="com.example.watchandrate.user_interface.EditReviewFragment"
        android:label="Edit Review">

        <argument
            android:name="reviewId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.watchandrate.user_interface.ProfileFragment"
        android:label="ProfileFragment" />
    <fragment
        android:id="@+id/commentsFragment"
        android:name="com.example.watchandrate.user_interface.CommentsFragment"
        android:label="Comments">

        <argument
            android:name="reviewId"
            app:argType="string" />
    </fragment>
</navigation>