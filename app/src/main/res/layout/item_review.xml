<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_review_card"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top row: user, movie, actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ed"
            android:textColor="#444444"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMovieTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="SUPERMAN"
            android:textColor="#3F37C9"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnEditReview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Edit review"
            android:src="@android:drawable/ic_menu_edit" />

        <ImageButton
            android:id="@+id/btnDeleteReview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Delete review"
            android:src="@android:drawable/ic_menu_delete" />
    </LinearLayout>

    <!-- Review text -->
    <TextView
        android:id="@+id/tvReviewText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="AMAZING!"
        android:textColor="#222222"
        android:textSize="16sp" />

    <!-- Bottom row: Open / Like / Comments -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOpenReview"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="#F5F7FF"
            android:text="Open"
            android:textColor="#222222"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLikeReview"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#F5F7FF"
            android:text="♡ Like · 0"
            android:textColor="#3F37C9"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCommentsReview"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#EEF4FF"
            android:text="0 comments"
            android:textColor="#3F37C9"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>