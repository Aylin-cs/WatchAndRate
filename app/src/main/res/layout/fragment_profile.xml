<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F3FA"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvProfileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Profile"
        android:textSize="26sp"
        android:layout_marginEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:textStyle="bold"
        android:textColor="#333333"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profileCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_review_card"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvProfileTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvProfileHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit your profile"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#333333"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="email@example.com"
            android:textColor="#666666"
            android:textSize="15sp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvProfileHint"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/ivProfileImage"
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:layout_marginTop="18dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            android:background="@drawable/bg_review_card"
            android:padding="5dp"
            app:layout_constraintTop_toBottomOf="@id/tvEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnSelectProfileImage"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Change Photo"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:backgroundTint="#EDE7F6"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/ivProfileImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <Button
            android:id="@+id/btnDeleteProfileImage"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Delete Photo"
            android:layout_height="36dp"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textColor="#D9534F"
            android:backgroundTint="#FDECEC"
            app:layout_constraintTop_toBottomOf="@id/btnSelectProfileImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Display name"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/btnDeleteProfileImage"
            app:layout_constraintEnd_toEndOf="@id/etUsername" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_review_card"
            android:hint="Username"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#333333"
            app:layout_constraintTop_toBottomOf="@id/tvNameLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="Save"
            android:textColor="@android:color/white"
            android:backgroundTint="#FFFFFF"
            android:background="@drawable/bg_review_card"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/etUsername"
            app:layout_constraintStart_toEndOf="@id/btnBackToReviews"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnBackToReviews"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="Back"
            android:textColor="@android:color/white"
            android:backgroundTint="#FFFFFF"
            android:background="@drawable/bg_review_card"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/etUsername"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSaveProfile" />

        <TextView
            android:id="@+id/tvProfileStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="center"
            android:textColor="#4CAF50"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnSaveProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>